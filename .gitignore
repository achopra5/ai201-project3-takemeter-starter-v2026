# API keys — never commit these
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Hugging Face model cache — big, and rebuildable
.cache/
models/

# The notebook's training output directory. Checkpoints are hundreds of MB and
# they are not evidence of anything — results.json is. Without this line a
# `git add -A` in Colab commits a model checkpoint to your repo.
takemeter_out/

# Separate validation experiments retain metrics/protocols; model weights are local.
experiments/*/runs/**/epoch-*/
experiments/*/runs/**/trainer/

# Local preservation copies remain on disk; committed originals and hash
# manifests provide compact verification in clean clones.
data/backups/
experiments/*/originals/
experiments/*/training.log
experiments/*/tests.log
experiments/*/runs/*/train_predictions_epoch*.csv
experiments/*/final_test_seed*.json
# Search catalogs are retrieval intermediates; pinned response pages/manifests
# are necessary source evidence and remain tracked.
data/supplemental_scans/*/catalog.json

# OS noise
.DS_Store
Thumbs.db

# Local review-process lock; proposals, journal and audits must remain tracked.
data/.annotation_review.lock

# NOTE: results.json, results_three_seeds.json and baseline_results.json are
# deliberately NOT ignored. They're evidence the run actually happened, and
# they're part of what gets graded. Commit them.
